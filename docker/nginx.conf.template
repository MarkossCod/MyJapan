# A porta é injetada pelo entrypoint (envsubst), porque o Render escolhe a
# porta em tempo de execução através da variável PORT.

user www-data;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 20m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml
        application/wasm;

    server {
        listen ${PORT};
        server_name _;

        root /var/www/html/public;
        index index.php index.html;

        charset utf-8;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        # Assets versionados pelo Vite: podem ser cacheados agressivamente.
        location /build/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Bundle estático da experiência 3D.
        #
        # Precisa de dois blocos. A regra antiga cobria a pasta inteira com
        # `expires 7d`, e isso incluía o index.html — que, diferente dos
        # arquivos de assets/, não tem hash no nome. Resultado: depois da
        # primeira visita, o navegador servia o hero antigo por uma semana e
        # nenhuma alteração no HTML aparecia, mesmo com o deploy correto.
        #
        # O nginx escolhe o prefixo mais longo, então assets/ vence sobre a
        # regra geral abaixo.
        location /japao-3d/assets/ {
            expires 7d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # O HTML de entrada revalida sempre. Com o ETag, quando nada mudou a
        # resposta é um 304 vazio — barato, e nunca congela.
        location /japao-3d/ {
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ =404;
        }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_hide_header X-Powered-By;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
